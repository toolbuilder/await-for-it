{
  "include": ["src/**/*.js", "test/**/*.js"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,

    "types": ["node"],

    "strict": false,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true
  }
}
