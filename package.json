{
  "name": "@toolbuilder/await-for-it",
  "version": "1.4.0",
  "description": "Manage async concurrency, task pools, rate limiting, and batching with chainable async iterables and built-in backpressure.",
  "keywords": [
    "async",
    "asynciterable",
    "queue",
    "publish-subscribe",
    "pool",
    "task",
    "asynchronous",
    "pub-sub",
    "iterable",
    "observable",
    "event"
  ],
  "homepage": "https://github.com/toolbuilder/await-for-it#readme",
  "bugs": {
    "url": "https://github.com/toolbuilder/await-for-it/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolbuilder/await-for-it.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/await-for-it.js",
  "types": "./src/await-for-it.d.ts",
  "exports": {
    ".": {
      "types": "./src/await-for-it.d.ts",
      "default": "./src/await-for-it.js"
    },
    "./package.json": "./package.json",
    "./src/*.js": {
      "types": "./src/*.d.ts",
      "default": "./src/*.js"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -f src/*.d.ts src/*.d.ts.map test/*.d.ts test/*.d.ts.map",
    "prepack": "pnpm run build",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "check:types": "pnpm run clean && tsc",
    "test": "node --test 'test/**/*test.js'",
    "test:examples": "node --test 'examples/*.js'",
    "check": "pnpm run check:types && pnpm run build && pnpm test && pnpm run test:examples",
    "validate:package": "npx -y publint && npx -y @arethetypeswrong/cli --pack . --profile esm-only",
    "release": "changelogen --release --no-github"
  },
  "dependencies": {
    "@toolbuilder/isnumber": "^1.0.0",
    "@toolbuilder/make-factory": "^1.0.0",
    "@toolbuilder/ring-buffer": "^2.0.0",
    "iterablefu": "^1.0.0"
  },
  "devDependencies": {
    "@toolbuilder/semaphore": "^1.0.0",
    "@types/node": "^26.6.5",
    "changelogen": "^0.6.2",
    "typescript": "^7.0.2"
  }
}
